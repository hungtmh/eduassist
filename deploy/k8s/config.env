APP_ENV=production
DEMO_MODE=false
TZ=Asia/Ho_Chi_Minh
PUBLIC_WEB_URL=https://eduassist-hcmus.malaysiawest.cloudapp.azure.com
CORS_ORIGINS=https://eduassist-hcmus.malaysiawest.cloudapp.azure.com
APP_DOMAIN=eduassist-hcmus.malaysiawest.cloudapp.azure.com
REDIS_URL=redis://redis:6379/0
# Mỗi pod MỘT tiến trình: mở rộng bằng thêm pod (HPA), không bằng thêm tiến trình trong pod
WEB_CONCURRENCY=1
# Chỉ tin header X-Forwarded-For từ dải IP của pod (Caddy). Dải mặc định của Azure CNI Overlay.
FORWARDED_ALLOW_IPS=10.244.0.0/16
# Kết nối database mỗi pod: (6 + 3 + 4) x tối đa 10 pod ứng dụng < max_connections=200 của Postgres
DB_POOL_SIZE=6
DB_AUTH_POOL_SIZE=3
DB_ASYNC_POOL_SIZE=4
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
LLM_MASK_PII=true
LLM_MAX_CONCURRENT=10
PUBLIC_CHAT_GLOBAL_PER_MINUTE=20
BACKGROUND_LLM=true
DAILY_RUN_HOUR=7
ADMIN_USERNAME=quantri
ADMIN_NAME=Quản trị viên
WORKER_HEARTBEAT_FILE=/tmp/worker.alive
