# Chép thành deploy/k8s/secrets.env (đã nằm trong .gitignore) rồi điền. deploy.sh đưa các giá trị này vào Secret.
# Mật khẩu database, JWT_SECRET... do deploy.sh tự sinh (deploy/k8s/.state/generated.env), không cần điền.

# https://console.groq.com/keys
GROQ_API_KEY=

# Gmail gửi email (quên mật khẩu, kích hoạt tài khoản, nhắc nợ). Cần bật xác minh 2 bước rồi tạo App Password:
# https://myaccount.google.com/apppasswords  (16 ký tự, bỏ dấu cách)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Email của tài khoản quản trị đầu tiên (để tự đặt lại mật khẩu khi quên)
ADMIN_EMAIL=
