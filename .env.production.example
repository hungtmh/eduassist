# Mẫu cấu hình production. Chép thành .env.production (KHÔNG commit file đó), điền đủ rồi chạy:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Tạo chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# API sẽ TỪ CHỐI khởi động nếu còn khoá mặc định hoặc khoá quá ngắn.

# ---- Tên miền & HTTPS ----
APP_DOMAIN=app.anhduong.vn
ACME_EMAIL=it@anhduong.vn

# ---- Bí mật (bắt buộc đổi) ----
JWT_SECRET=
POSTGRES_PASSWORD=
AGENT_RO_PASSWORD=

# ---- Tài khoản quản lý đầu tiên (chỉ tạo khi hệ thống chưa có quản lý nào) ----
# Bỏ trống ADMIN_PASSWORD -> hệ thống sinh mật khẩu tạm, in trong log của service setup. Phải đổi khi đăng nhập.
ADMIN_USERNAME=quantri
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- LLM ----
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Che email / SĐT trước khi gửi dữ liệu cho LLM (nên để true)
LLM_MASK_PII=true

# ---- Email thật (bắt buộc cho quên mật khẩu, kích hoạt tài khoản, nhắc nợ) ----
# Ví dụ: Google Workspace smtp.gmail.com:587 starttls; Amazon SES; SendGrid; Mailgun.
# Nhớ cấu hình SPF, DKIM, DMARC cho tên miền gửi để email không vào Spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tuvan@anhduong.vn

# ---- Agent chạy nền ----
BACKGROUND_LLM=true
DAILY_RUN_HOUR=7

# ---- Sức chịu tải (docs/SCALING_PLAN.md) ----
# Số tiến trình API nghiệp vụ = số vCPU của máy (mỗi tiến trình khoảng 150-250 req/s). Redis đã có sẵn trong compose.
API_WORKERS=2
CHAT_WORKERS=1
# Số lượt chat LLM chạy cùng lúc trên TOÀN hệ thống; đặt theo hạn mức của gói LLM (gói miễn phí chỉ vài lượt/phút)
LLM_MAX_CONCURRENT=30
CHAT_TURN_TIMEOUT_SECONDS=45
# Postgres: máy DB 16 GB RAM thì 4GB / 12GB
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
# Nhiều máy API dùng chung một Postgres: bật PgBouncer (một máy thì để trống, nối thẳng nhanh hơn)
#   APP_DB_ADDR=pgbouncer:6432
#   DB_VIA_PGBOUNCER=true
#   rồi chạy thêm: --profile pgbouncer
# Nhiều máy API sau Caddy: liệt kê địa chỉ, cách nhau bằng dấu cách
#   API_UPSTREAMS=10.0.0.11:8000 10.0.0.12:8000 10.0.0.13:8000
# Bảo vệ /metrics (Prometheus hỏi thẳng api:8000/metrics trong mạng nội bộ; Caddy không mở ra ngoài)
METRICS_TOKEN=

# ---- Sao lưu ----
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# ---- Theo dõi lỗi (tuỳ chọn) ----
SENTRY_DSN=

# ---- Langfuse (tuỳ chọn; dữ liệu thật nên tự host Langfuse) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
