# ---- LLM (bắt buộc) ----
# Key miễn phí: https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# ---- Database ----
POSTGRES_PASSWORD=app_rw_dev_pw
AGENT_RO_PASSWORD=agent_ro_dev_pw
DATABASE_URL=postgresql://app_rw:app_rw_dev_pw@localhost:5433/eduassist
AGENT_RO_URL=postgresql://agent_ro:agent_ro_dev_pw@localhost:5433/eduassist

# ---- API ----
# Đổi thành chuỗi ngẫu nhiên dài khi deploy:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
# development | production. production: bắt buộc khoá mạnh, tắt /docs
APP_ENV=development
# true: dữ liệu giả lập + tài khoản demo (demo123) + nút đăng nhập nhanh. Production: false
DEMO_MODE=true
# Địa chỉ web (dùng trong link đặt lại mật khẩu gửi qua email)
PUBLIC_WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
# Origin của web Next.js được gọi API (nhiều origin cách nhau dấu phẩy)
CORS_ORIGINS=http://localhost:3000
# URL API mà TRÌNH DUYỆT gọi tới (nhúng vào bản build của web)
PUBLIC_API_URL=http://localhost:8000

# ---- Agent chạy nền ----
# false = chỉ dùng bản mẫu do code soạn (không gọi LLM) - hợp khi hết hạn mức free tier
BACKGROUND_LLM=true
DAILY_RUN_HOUR=7

# ---- Email (dev dùng Mailpit trong docker compose) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=tuvan@anhduong.example
# Máy chủ email thật: SMTP_SECURITY=starttls (cổng 587) hoặc ssl (465), kèm SMTP_USER / SMTP_PASSWORD
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=

# ---- Langfuse (tuỳ chọn - bỏ trống để tắt tracing) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- UI Chainlit ----
# Tạo bằng: uv run --group ui chainlit create-secret
CHAINLIT_AUTH_SECRET=
